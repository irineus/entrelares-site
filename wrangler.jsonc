{
  // Cloudflare Workers (static assets) deploy config — used by `npx wrangler deploy`
  // in CI. Only files under public/ are uploaded.
  //
  // Two environments (mirrors the app's dev/prod split):
  //   · PRODUCTION (default / top-level): worker `guardacompartilhada-site`,
  //     custom domain guardacompartilhada.com, deployed from `main` (deploy.yml).
  //     A plain `wrangler deploy` (no --env) uses this block and ignores env.* .
  //   · PREVIEW (`wrangler deploy --env preview`): worker
  //     `guardacompartilhada-site-preview`, custom domain
  //     preview.guardacompartilhada.com, deployed from `preview`
  //     (deploy-preview.yml). Analytics are stripped and the site is set to
  //     noindex at deploy time — the preview carries no stats and must not be
  //     indexed (no duplicate content with production). The custom domain is
  //     attached ONCE in the Cloudflare dashboard (not declared here, so the CI
  //     token needs no zone/DNS permission — same as production).
  "name": "guardacompartilhada-site",
  "account_id": "1185ad84960bdaf12e52096fe8df0dc9",
  "compatibility_date": "2026-07-22",
  // Worker entrypoint (L-09): serves the static assets AND one dynamic endpoint,
  // POST /api/subscribe, for the materials / newsletter opt-in. Asset requests
  // are matched first; only a miss reaches the Worker, which delegates non-API
  // routes back to the ASSETS binding (preserving 404-page handling).
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // S-15/C-6: opt-in evidence log (date, time, IP) for the newsletter consent.
  // The legal review accepted plain opt-in ONLY on condition that this log exists.
  // One namespace PER ENVIRONMENT so preview submissions never mix into the
  // production evidence — the preview worker dry-runs sends but still records.
  "kv_namespaces": [
    { "binding": "OPTIN_LOG", "id": "cf5ae659d87f4c9d9bd1e07b08b140de" }
  ],
  // Non-secret config for /api/subscribe. The RESEND_API_KEY is a SECRET and is
  // NOT declared here — set it with `wrangler secret put RESEND_API_KEY` or in
  // the Cloudflare dashboard (Workers → Settings → Variables). Without it the
  // endpoint runs in dry-run mode (no side effects) — the default on preview.
  "vars": {
    "RESEND_SEGMENT_ID": "17fe52ba-a9ef-41a9-94b6-09e1f251503c",
    "FROM_EMAIL": "Guarda Compartilhada <materiais@guardacompartilhada.com>",
    "REPLY_TO": "contato@guardacompartilhada.com"
  },
  "env": {
    "preview": {
      "name": "guardacompartilhada-site-preview",
      // Re-declared explicitly so the assets deploy is independent of any
      // wrangler config-inheritance nuance across versions.
      "main": "src/index.js",
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      },
      "observability": {
        "enabled": true
      },
      "kv_namespaces": [
        { "binding": "OPTIN_LOG", "id": "752b58df98dc4a889e89615838ac1fe6" }
      ],
      // Preview has NO RESEND_API_KEY secret by default → /api/subscribe dry-runs
      // (no real e-mail, no contact written). Add the secret to this worker too if
      // you want to test the full flow live on preview.
      "vars": {
        "RESEND_SEGMENT_ID": "17fe52ba-a9ef-41a9-94b6-09e1f251503c",
        "FROM_EMAIL": "Guarda Compartilhada <materiais@guardacompartilhada.com>",
        "REPLY_TO": "contato@guardacompartilhada.com"
      }
    }
  }
}
