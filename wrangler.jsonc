{
  // Cloudflare Workers (static assets) deploy config — used by `npx wrangler deploy`
  // in CI. Only files under public/ are uploaded.
  //
  // Two environments (mirrors the app's dev/prod split):
  //   · PRODUCTION (default / top-level): worker `entrelares-site` (F-54 — worker names are
  //     immutable, so the rebrand meant a NEW worker and the domains were moved by hand at the
  //     12/08/2026 promotion; the old apex now 301s here),
  //     custom domain entrelares.app, deployed from `main` (deploy.yml).
  //     A plain `wrangler deploy` (no --env) uses this block and ignores env.* .
  //   · PREVIEW (`wrangler deploy --env preview`): worker
  //     `entrelares-site-preview`, custom domain
  //     preview.entrelares.app, deployed from `preview`
  //     (deploy-preview.yml). Analytics are stripped and the site is set to
  //     noindex at deploy time — the preview carries no stats and must not be
  //     indexed (no duplicate content with production). The custom domain is
  //     attached ONCE in the Cloudflare dashboard (not declared here, so the CI
  //     token needs no zone/DNS permission — same as production).
  "name": "entrelares-site",
  "account_id": "1185ad84960bdaf12e52096fe8df0dc9",
  "compatibility_date": "2026-07-22",
  // Worker entrypoint (L-09): serves the static assets AND one dynamic endpoint,
  // POST /api/subscribe, for the materials / newsletter opt-in. Asset requests
  // are matched first; only a miss reaches the Worker, which delegates non-API
  // routes back to the ASSETS binding (preserving 404-page handling).
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // L-34: the pages that carry a product parameter reach the Worker FIRST,
    // so it can write the live value in (src/serve-params.js). Only these —
    // images, CSS and every other page keep the fast path where a hit never
    // wakes the Worker. A page that gains a `data-param` joins this list in
    // the same delivery; test/params.test.js fails otherwise.
    "run_worker_first": [
      "/",
      "/en",
      "/en/",
      "/blog/como-funciona-guarda-compartilhada",
      "/blog/como-montar-calendario-guarda-compartilhada",
      "/blog/modelos-de-rotina-guarda-compartilhada",
      "/ferramentas/gerador-de-rotina-de-guarda"
    ]
  },
  "observability": {
    "enabled": true
  },
  // L-20: the sequence's only clock. Once a day, 12:00 UTC (09:00 in
  // America/Sao_Paulo) — a marketing e-mail should land in the morning, and a
  // daily tick is all a 3-step sequence measured in DAYS can possibly need.
  // The Worker's `scheduled()` walks the queue; DAILY_CAP in src/sequence.js is
  // what keeps it from ever eating the transactional allowance.
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  // S-15/C-6: opt-in evidence log (date, time, IP) for the newsletter consent.
  // The legal review accepted plain opt-in ONLY on condition that this log exists.
  // One namespace PER ENVIRONMENT so preview submissions never mix into the
  // production evidence — the preview worker dry-runs sends but still records.
  "kv_namespaces": [
    { "binding": "OPTIN_LOG", "id": "cf5ae659d87f4c9d9bd1e07b08b140de" }
  ],
  // Non-secret config for /api/subscribe. The RESEND_API_KEY is a SECRET and is
  // NOT declared here — set it with `wrangler secret put RESEND_API_KEY` or in
  // the Cloudflare dashboard (Workers → Settings → Variables). Without it the
  // endpoint runs in dry-run mode (no side effects) — the default on preview.
  "vars": {
    "RESEND_SEGMENT_ID": "17fe52ba-a9ef-41a9-94b6-09e1f251503c",
    "FROM_EMAIL": "Entrelares <materiais@entrelares.app>",
    "REPLY_TO": "contato@entrelares.app",
    // L-34: the app's public feed (T-81) — PRODUCTION project. Anonymous by
    // design; the whitelist is a column in the app's database, not a secret.
    // Fulcrum 03.4.5: reached through the Fulcrum gateway, which answers 401
    // without its tenant key — PARAMS_KEY is that key for the `entrelares`
    // env (PUBLIC by design; the same one the app ships). Read by the Worker
    // (src/serve-params.js) AND by the deploy's bake (tool/bake-params.mjs).
    "PARAMS_URL": "https://api.entrelares.app/functions/v1/public-settings",
    "PARAMS_KEY": "6cc0c37647edce18502b231522b60f861e753a92da1929df6386c7b7a444127e"
  },
  "env": {
    "preview": {
      "name": "entrelares-site-preview",
      // Re-declared explicitly so the assets deploy is independent of any
      // wrangler config-inheritance nuance across versions.
      "main": "src/index.js",
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        // L-34: the pages that carry a product parameter reach the Worker FIRST,
        // so it can write the live value in (src/serve-params.js). Only these —
        // images, CSS and every other page keep the fast path where a hit never
        // wakes the Worker. A page that gains a `data-param` joins this list in
        // the same delivery; test/params.test.js fails otherwise.
        "run_worker_first": [
          "/",
          "/en",
          "/en/",
          "/blog/como-funciona-guarda-compartilhada",
          "/blog/como-montar-calendario-guarda-compartilhada",
          "/blog/modelos-de-rotina-guarda-compartilhada",
          "/ferramentas/gerador-de-rotina-de-guarda"
        ]
      },
      "observability": {
        "enabled": true
      },
      // NO cron on preview, stated rather than inherited — the file already
      // re-declares everything explicitly to stay clear of wrangler's
      // config-inheritance nuances. An EMPTY array is the documented way to say
      // it: "If the crons property is an empty array then all the Cron Triggers
      // are removed" (developers.cloudflare.com/workers/configuration/
      // cron-triggers/, read 11/09/2026). Preview has no RESEND_API_KEY either,
      // and `runSequence` refuses to advance state it did not actually send, so
      // preview is silent on both counts.
      "triggers": {
        "crons": []
      },
      "kv_namespaces": [
        { "binding": "OPTIN_LOG", "id": "752b58df98dc4a889e89615838ac1fe6" }
      ],
      // Preview has NO RESEND_API_KEY secret by default → /api/subscribe dry-runs
      // (no real e-mail, no contact written). Add the secret to this worker too if
      // you want to test the full flow live on preview.
      "vars": {
        "RESEND_SEGMENT_ID": "17fe52ba-a9ef-41a9-94b6-09e1f251503c",
        "FROM_EMAIL": "Entrelares <materiais@entrelares.app>",
        "REPLY_TO": "contato@entrelares.app",
        // L-34: preview reads the DEV project's feed — the same database the
        // QA app (qa.entrelares.app) runs on, so a console edit on dev shows here.
        // Fulcrum 03.4.5: through the gateway's DEV env, with its tenant key.
        "PARAMS_URL": "https://api-dev.entrelares.app/functions/v1/public-settings",
        "PARAMS_KEY": "6a6abea8f2bb37df2412172620f5d9ab2742e7715c2efd8d42f10e59fc32772a"
      }
    }
  }
}
